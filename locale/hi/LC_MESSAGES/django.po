msgid "Card ID"
msgstr "कार्ड आईडी"

msgid "Match bottoms"
msgstr "मैचिंग बॉटम"

msgid ""
"All advice here is a styling suggestion. Colors on your screen vary by phone "
"and brightness."
msgstr ""
"यहाँ दी गई सारी सलाह केवल स्टाइलिंग सुझाव है। आपकी स्क्रीन पर रंग फ़ोन और "
"ब्राइटनेस के अनुसार अलग दिख सकते हैं।"

msgid "Enter the card ID that the staff gave you."
msgstr "स्टाफ़ ने जो कार्ड आईडी बताई है, उसे दर्ज करें।"

msgid "Continue"
msgstr "आगे बढ़ें"

msgid ""
"This site remembers your device to count visits. It does not store your name "
"or photo."
msgstr ""
"यह साइट विज़िट गिनने के लिए आपके डिवाइस को याद रखती है। यह आपका नाम या फ़ोटो "
"सेव नहीं करती।"

msgid "Garments"
msgstr "कपड़े"

msgid "pick a color family"
msgstr "रंग का समूह चुनें"

msgid "Find a shop"
msgstr "दुकान खोजें"

msgid "Find your shop"
msgstr "अपनी दुकान खोजें"

msgid "Pick the shop you are in. Staff there will help you with your card."
msgstr ""
"जिस दुकान में आप हैं, उसे चुनें। वहाँ का स्टाफ़ आपके कार्ड में मदद करेगा।"

msgid "No shops are listed yet."
msgstr "अभी कोई दुकान लिस्ट में नहीं है।"

msgid "Choose a garment"
msgstr "कपड़ा चुनें"

msgid "What are you looking for?"
msgstr "आप क्या ढूंढ रहे हैं?"

msgid "Bottom types"
msgstr "बॉटम के प्रकार"

msgid "Styling suggestions for the bottom color:"
msgstr "बॉटम के रंग के लिए स्टाइलिंग सुझाव:"

msgid "Enlarge"
msgstr "बड़ा करें"

msgid "Tap to enlarge"
msgstr "बड़ा करने के लिए टैप करें"

msgid "Top"
msgstr "टॉप"

msgid "Bottom"
msgstr "बॉटम"

msgid "Styling suggestion. Colors vary by phone and brightness."
msgstr "स्टाइलिंग सुझाव। रंग फ़ोन और ब्राइटनेस के अनुसार अलग दिख सकते हैं।"

msgid "Close"
msgstr "बंद करें"

msgid "No suggestions for this combination yet."
msgstr "इस जोड़ी के लिए अभी कोई सुझाव नहीं है।"

#, python-format
msgid "Back to %(name)s shades"
msgstr "%(name)s के शेड्स पर वापस जाएँ"

msgid "Your top"
msgstr "आपका टॉप"

msgid "Pick a bottom-wear type."
msgstr "बॉटम-वियर का प्रकार चुनें।"

msgid "Casual"
msgstr "कैज़ुअल"

msgid "Formal and office"
msgstr "फ़ॉर्मल और ऑफ़िस"

msgid "Smart casual"
msgstr "स्मार्ट कैज़ुअल"

msgid "Home and loungewear"
msgstr "घर और आरामदायक पहनावा"

msgid "Color families"
msgstr "रंगों के समूह"

msgid "Styling suggestions for your tone."
msgstr "आपके टोन के लिए स्टाइलिंग सुझाव।"

msgid "Tap a shade to see matching bottoms."
msgstr "मैचिंग बॉटम देखने के लिए किसी शेड पर टैप करें।"

msgid "Best for you"
msgstr "आपके लिए सबसे अच्छा"

msgid "Good option"
msgstr "अच्छा विकल्प"

msgid "No suggestions in this color family yet."
msgstr "इस रंग समूह में अभी कोई सुझाव नहीं है।"

msgid "We could not find this card ID. Check the card and try again."
msgstr "यह कार्ड आईडी नहीं मिली। कार्ड जाँचें और फिर से कोशिश करें।"

msgid "English"
msgstr "English"

msgid "हिन्दी"
msgstr "हिन्दी"
